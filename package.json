{
  "name": "voice-audit-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "tsx src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "voice": "lk agent console src/agent.ts -- --import tsx",
    "dev:dashboard": "pnpm --dir dashboard dev",
    "build:dashboard": "pnpm --dir dashboard build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-cartesia": "1.9.2",
    "@livekit/agents-plugin-deepgram": "^1.9.1",
    "@livekit/agents-plugin-silero": "^1.9.1",
    "dotenv": "^17.2.3",
    "livekit-server-sdk": "^2.19.1",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
