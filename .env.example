# Use the same database URI as Circuit's DB_URL for ticket audits.
CIRCUIT_DB_URL=

# Speech and language services used by the agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_OUTBOUND_TRUNK_ID=
DEEPGRAM_API_KEY=
# Use your own Cartesia account for a private cloned voice.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional voice delivery controls (Sonic 3).
CARTESIA_SPEED=1
CARTESIA_EMOTION=
CARTESIA_VOLUME=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Cloudflare Access protects the hosted API.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=

# Production dashboard/API URLs. Leave dashboard origin blank for same-origin hosting.
VOICE_AUDIT_DASHBOARD_ORIGIN=
