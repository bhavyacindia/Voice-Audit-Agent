# Use the same database URI as Circuit's DB_URL for ticket audits.
CIRCUIT_DB_URL=

# Speech and language services used by the agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Use your own Cartesia account for a private cloned voice.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional voice delivery controls (Sonic 3).
CARTESIA_SPEED=1
CARTESIA_EMOTION=
CARTESIA_VOLUME=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# The dashboard displays the selected queue; cloud calling needs worker/provider setup.
