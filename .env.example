# Local MongoDB database.
MONGODB_URI=
VOICE_AUDIT_DB=voice_audit_local

# Speech and language services used by the agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Use your own Cartesia account for a private cloned voice.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional voice delivery controls (Sonic 3).
CARTESIA_SPEED=1
CARTESIA_EMOTION=
CARTESIA_VOLUME=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Set this per command after creating a Contact in the dashboard:
# VOICE_AUDIT_CONTACT_ID=<contact-id>
